# Base URL the axios instance prefixes onto every request.
# Dev: keep "/api/v1" so calls flow through the Vite proxy (no CORS needed).
# Prod: set the absolute API origin, e.g. https://petrox.quicko.rw/api/v1
VITE_API_URL=/api/v1

# Dev-proxy target. Not exposed to the browser (no VITE_ prefix).
API_PROXY_TARGET=https://petrox.quicko.rw
